# Copy to .env and adjust. NEVER commit the real .env file.
# All of these have safe local defaults in docker-compose.yml.

MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=cricket
MYSQL_USER=cricket
MYSQL_PASSWORD=cricket

# Host ports published by the DEV compose file. Override if a local service
# already owns the default (e.g. a Windows MySQL80 service on 3306, or a local
# Redis on 6379). Container-internal ports are unchanged (mysql:3306, redis:6379).
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6379

# Spring Boot -> external services
FASTAPI_BASE_URL=http://localhost:8000
PREDICTION_DEFAULT_MODEL=xgboost
PREDICTION_MC_SIMULATIONS=300
PREDICTION_AUTO_ON_BALL=true

# Optional AI commentary (requires local Ollama; off by default)
COMMENTARY_ENABLED=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
